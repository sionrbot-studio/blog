{
  "name": "sionrbot-blog",
  "type": "module",
  "version": "1.10.2",
  "engines": {
    "node": "^24.22.2 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "vp lint . && vp run lint:astro",
    "i18n:check": "x18n check --strict",
    "format": "vp fmt .",
    "astro": "astro",
    "test:build": "vp test --project build",
    "test:e2e": "node tests/support/run-e2e.ts deterministic",
    "test:e2e:ai": "node tests/support/run-e2e.ts ai",
    "test:e2e:visual": "node tests/support/run-e2e.ts visual"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@iconify-json/lucide": "^1.2.157",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.13",
    "astro-icon": "^1.2.0",
    "katex": "^0.19.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "pnpm@11.28.10",
  "devDependencies": {
    "@ai-sdk/openai": "4.0.122",
    "@astrojs/ts-content-mapper": "0.2.0",
    "@e2e-dev/web": "0.16.1",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@x18n/cli": "0.1.14",
    "ai": "^7.0.179",
    "cf": "1.0.0-rc.2",
    "cheerio": "1.2.0",
    "e2e": "0.24.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "fast-xml-parser": "5.12.1",
    "pagefind": "^1.6.0",
    "release-please": "17.11.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.166.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "license": "MIT",
  "description": "A minimal, typography-first Astro theme."
}
